# Frontend/build-time environment variables for washero-premium-clean.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and must never be
# committed — see the security audit that added this file for why (a previous `.env` containing
# the project's Supabase anon/publishable key, public Google Maps key, public VAPID key, and
# Google Ads IDs was tracked in git history; none of those were service-role/private/server
# secrets, but the file should never have been committed regardless).
#
# Anything prefixed VITE_ is bundled into client-side JS and is inherently public once shipped —
# only put values here that are safe to ship to a browser (anon keys, public API keys restricted
# by referrer/domain on the provider's side, public IDs). Server-side/private secrets (service
# role keys, API tokens, webhook secrets, VAPID private key, etc.) belong in Supabase Edge
# Function secrets instead — see supabase/functions/.env.example, not this file.

# ---------------------------------------------------------------------------
# Supabase (anon/publishable key only — safe for client exposure by design)
# ---------------------------------------------------------------------------
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Google Maps (public, referrer-restricted browser key — not a server credential)
# ---------------------------------------------------------------------------
# Canonical name used by PlacesAutocomplete + admin demand map.
# REQUIRED in Vercel / local production builds.
# After `.env` was removed from git, this value is NOT available unless set in
# the host's build-time secrets/env UI. Without it, booking shows
# "Falta configurar Google Maps." and street-address autocomplete cannot start.
#
# Enable in Google Cloud for this key:
#   - Maps JavaScript API
#   - Places API (New)  — required for the /reservar address autocomplete
# Restrict the key by HTTP referrer to your production domains
# (e.g. https://washero.ar/*, https://www.washero.ar/*, https://*.vercel.app/*).
VITE_GOOGLE_MAPS_PUBLIC_KEY=
# Temporary legacy aliases (avoid; migrate to VITE_GOOGLE_MAPS_PUBLIC_KEY):
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_KEY=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
VITE_ADDRESS_FIRST_BOOKING=
VITE_ADDRESS_FIRST_ENABLED=

# ---------------------------------------------------------------------------
# Web push (public VAPID key only — private key lives server-side, see
# supabase/functions/.env.example's WEB_PUSH_VAPID_PRIVATE_KEY)
# ---------------------------------------------------------------------------
VITE_WEB_PUSH_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Google Ads (public conversion IDs/labels, not credentials)
# ---------------------------------------------------------------------------
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_BOOKING_CONVERSION_LABEL=
VITE_GOOGLE_ADS_PAYMENT_CONVERSION_LABEL=

# ---------------------------------------------------------------------------
# Finance expenses sync (Google Form → Sheet → /admin/finanzas)
# ---------------------------------------------------------------------------
# These are SERVER secrets for the `sync-finance-expenses` Edge Function.
# Set them with `supabase secrets set`, not in this Vite .env file.
#
# 1) Create a Google Cloud service account with Sheets API enabled.
# 2) Share the spreadsheet with the SA email (Viewer).
# 3) In the Form, set ¿Quién pagó? options to: Salva | Moru | Washero
# 4) Deploy migration + function, then click "Sincronizar gastos" in Finanzas.
#
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=<full JSON of the service account>
# GOOGLE_SHEETS_SPREADSHEET_ID=1OqtH84vsW9MM1ZcNtExJn-nZwE0Mif95t7y9n6zBE-E
# GOOGLE_SHEETS_RANGE=Respuestas_Form
# FINANCE_SYNC_SECRET=<optional shared secret for pg_cron; see supabase/optional/finance_expenses_sync_schedule.sql>
